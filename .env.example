# Copy to .env.local and fill in. Never commit real keys.
# All of these are read on the server only; nothing here reaches the browser.

# Which railway data source to use:
#   sample    — built-in invented network with simulated live data (development/demo only)
#   railradar — RailRadar third-party API (needs RAILRADAR_API_KEY)
# In production this must be set explicitly; there is no silent fallback to sample data.
RAIL_DATA_PROVIDER=sample

# RailRadar (https://railradar.in/docs). Free sandbox ≈ 100 requests/month.
RAILRADAR_API_KEY=
# RAILRADAR_BASE_URL=https://api.railradar.in/v1

# Live data older than this (minutes) is shown as "estimated / may be outdated".
LIVE_STALE_AFTER_MINUTES=15

# Upper bound on station timetables fetched per journey-planner request (protects API quota).
PLANNER_MAX_STATION_LOOKUPS=12

# LOG_LEVEL=info
